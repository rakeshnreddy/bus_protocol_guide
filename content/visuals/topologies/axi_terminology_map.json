    { "id": "e-response-id", "source": "response", "target": "id", "label": "matches the original request", "kind": "response", "tone": "secondary", "labelPosition": { "x": 500, "y": 590 } },
    { "id": "e-response-complete", "source": "response", "target": "complete", "label": "retires state", "kind": "response", "tone": "secondary", "waypoints": [{ "x": 905, "y": 545 }, { "x": 905, "y": 420 }], "labelPosition": { "x": 925, "y": 475 } }
  ],
  "highlightedPath": ["transaction", "e-transaction-burst", "burst", "e-burst-beat", "beat", "e-beat-handshake", "handshake", "address-accepted", "e-address-outstanding", "outstanding", "e-outstanding-complete", "complete"],
  "annotations": [
    { "nodeId": "transaction", "message": "A read transaction uses AR then one or more R beats. A write transaction uses AW, one or more W beats, then one B response." },
    { "nodeId": "beat", "message": "A beat is one accepted transfer on a data channel. Address and response handshakes are channel transfers, but they are not data beats." },
    { "nodeId": "outstanding", "message": "After its address is accepted, a read remains outstanding until the final R handshake; a write remains outstanding until its B handshake." },
    { "nodeId": "id", "message": "IDs identify transaction streams and let different-ID responses complete out of order. Responses for the same ID retain their required order." },
    { "edgeId": "e-response-id", "message": "RID or BID lets the master correlate returning information with ARID or AWID. AXI4-Lite normally omits IDs and therefore keeps responses in order." }
  ]
}
