    { "id": "lifecycle", "label": "Outstanding lifetime", "x": 25, "y": 240, "width": 950, "height": 185, "tone": "fabric" },
    { "id": "correlation", "label": "Completion and correlation", "x": 25, "y": 455, "width": 950, "height": 180, "tone": "target" }
  ],
  "nodes": [
    { "id": "transaction", "label": "Transaction\none read or write", "type": "concept", "x": 130, "y": 125, "width": 175, "height": 64 },
    { "id": "burst", "label": "Burst\ndata payload", "type": "concept", "x": 385, "y": 125, "width": 165, "height": 64 },
