  "annotations": [
    { "nodeId": "axi-sequences", "message": "Create independent AW, W, and AR timing, vary IDs, reuse IDs, fill outstanding queues, inject response errors, and drive contention across targets." },
    { "edgeId": "axi-agent-dut", "message": "Each channel handshakes independently. The agent must never make source VALID depend on destination READY, and stalled payload must remain stable." },
    { "nodeId": "axi-monitor", "message": "Allocate only on accepted AW or AR handshakes, count only accepted W or R beats, and retire only on accepted B or RLAST. Observing VALID alone is not a transfer." },
    { "nodeId": "axi-scoreboard", "message": "Match BID and RID to outstanding transaction context, then preserve issue order within each ID. Address, ID, burst attributes, byte enables, and channel direction all contribute to the expected result." },
    { "nodeId": "axi-assertions", "message": "Assertions cover channel stability, dependency rules, burst legality, LAST timing, and response correlation. Bounded progress belongs to the documented system contract, not the base AXI safety rules." },
    { "nodeId": "axi-coverage", "message": "Cross burst shape, response, ID reuse, outstanding depth, backpressure, and route contention. A hit proves the scenario occurred, not that the scoreboard result was correct." }
  ]
