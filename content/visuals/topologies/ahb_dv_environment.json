  "annotations": [
    { "nodeId": "driver", "message": "A small BFM can be appropriate for smoke tests; full VIP adds constrained stimulus, monitoring, and protocol services. The verification plan—not a slogan—decides what is sufficient." },
    { "nodeId": "monitor", "message": "The monitor reconstructs transactions only from accepted address and data phases. It must not advance its model while HREADY is LOW." },
    { "nodeId": "scoreboard", "message": "Expected and actual paths must remain independent. A scoreboard should compare address, direction, size, burst progression, data, and response ownership." },
    { "nodeId": "assertions", "message": "Assertions check cycle-level rules continuously, including their protocol-defined exceptions. They complement rather than replace end-to-end data checking." },
    { "nodeId": "coverage", "message": "Coverage measures planned scenarios and crosses. A hit is evidence that stimulus occurred, not proof that the result was correct." }
  ]
