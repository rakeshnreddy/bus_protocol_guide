    { "nodeId": "secure-source", "message": "HNONSEC is deasserted for a Secure transfer. Only a source operating with appropriate Secure authority can originate that attribution." },
    { "nodeId": "nonsecure-source", "message": "HNONSEC is asserted for a Non-secure transfer and remains aligned with HADDR and the other address-phase controls until the transfer is accepted." },
    { "nodeId": "policy", "message": "AHB5 defines the transfer attribute, not one mandatory policy-block placement. The interconnect, target, or a dedicated controller can enforce the system's address/security rules." },
    { "edgeId": "e-policy-error", "message": "A denied valid transfer completes with the normal two-cycle AHB ERROR response. The denial must not leak secure read data or update secure state." },
    { "nodeId": "error-response", "message": "Verification must test both routing and enforcement: the correct HNONSEC must reach the policy point, and a forbidden access must be rejected predictably." }
