{
  "id": "fp-ahb-hready-liveness",
  "type": "formal-property",
  "title": "AHB Example Bounded Completion Contract",
  "property": {
    "name": "Configured Bounded Liveness",
    "description": "This example assumes the implementation contract requires an accepted NONSEQ request to see HREADY HIGH within four cycles. Four is a teaching/configuration bound, not one universal AHB protocol limit.",
    "svaString": "assert property (@(posedge HCLK) (HTRANS == NONSEQ) |-> ##[0:4] (HREADY == 1));",
    "evaluatorRule": "ahb-hready-bounded-liveness"
  },
  "editableSignals": ["HREADY"],
  "waveform": {
    "id": "wf-ahb-hready-base",
    "type": "waveform",
    "title": "AHB Configured Completion Window",
    "cycleCount": 7,
    "signals": [
      {
        "name": "HCLK",
        "type": "clock",
        "values": ["P", "P", "P", "P", "P", "P", "P"]
      },
      {
        "name": "HTRANS",
        "type": "sideband",
        "values": ["IDLE", "NONSEQ", "SEQ", "IDLE", "IDLE", "IDLE", "IDLE"]
      },
      {
        "name": "HREADY",
        "type": "control",
        "values": ["1", "1", "1", "1", "1", "1", "1"]
      }
    ]
  }
}
