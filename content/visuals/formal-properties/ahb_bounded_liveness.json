{
  "id": "fp-ahb-hready-liveness",
  "type": "formal-property",
  "title": "AHB Liveness: HREADY Assertion",
  "property": {
    "name": "Bounded Liveness",
    "description": "Every NONSEQ transfer must see HREADY go high within 4 cycles. In real formal verification, liveness is often unbounded ('eventually'), but for this interactive teaching tool, we bound the property to a fixed window so we can give a definitive pass/fail within a short visible waveform.",
    "svaString": "assert property (@(posedge HCLK) (HTRANS == NONSEQ) |-> ##[0:4] HREADY == 1);",
    "evaluatorRule": "ahb-hready-bounded-liveness"
  },
  "editableSignals": ["HREADY"],
  "waveform": {
    "id": "wf-ahb-hready-base",
    "type": "waveform",
    "title": "AHB HREADY Base Waveform",
    "cycleCount": 7,
    "signals": [
      {
        "name": "HCLK",
        "type": "clock",
        "values": ["P", "P", "P", "P", "P", "P", "P"]
      },
      {
        "name": "HTRANS",
        "type": "data",
        "color": "#eab308",
        "values": ["IDLE", "NONSEQ", "SEQ", "IDLE", "IDLE", "IDLE", "IDLE"]
      },
      {
        "name": "HREADY",
        "type": "control",
        "color": "#3b82f6",
        "values": ["1", "1", "1", "1", "1", "1", "1"]
      }
    ]
  }
}
