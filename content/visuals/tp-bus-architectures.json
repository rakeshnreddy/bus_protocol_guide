  "annotations": [
    { "nodeId": "shared_bus", "message": "All participants share the same transfer resource, so arbitration permits only one master-owned route at a time." },
    { "edgeId": "e-p2p", "message": "The direct link needs no system-level arbitration, but adding every possible master-target pair scales poorly in wires and ports." },
    { "nodeId": "xbar", "message": "The switch fabric contains multiple internal paths. Master 1 can reach Slave 1 while Master 2 reaches Slave 2, provided the routes do not contend for the same target or another shared resource. Same-target requests still require arbitration, buffering, or backpressure." },
