    { "nodeId": "xbar", "message": "The read-address, read-data, write-address, write-data, and write-response networks arbitrate independently. Different targets can therefore make progress concurrently." },
    { "edgeId": "e-m0-xbar", "message": "Master-local ID 0x1 is legal even when another master uses the same local ID. Source-port context disambiguates the transactions inside the fabric." },
    { "edgeId": "e-xbar-s0", "message": "An implementation may prepend source bits, remap IDs, or keep source metadata internally. Verification must check the configured scheme rather than assume one fixed encoding." },
    { "edgeId": "e-xbar-s1", "message": "This second highlighted route can operate at the same time as route A because it targets a different slave. Contention would be arbitrated if both routes targeted the same slave channel." }
