  "annotations": [
    {
      "cycle": 1,
      "message": "First beat of the packet transfers."
    },
    {
      "cycle": 3,
      "message": "Receiver stalls (TREADY=0). The sender holds TDATA and TVALID."
    },
    {
      "cycle": 4,
