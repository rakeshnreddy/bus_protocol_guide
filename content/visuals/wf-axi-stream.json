    { "name": "TREADY", "type": "control", "color": "green", "values": ["1", "1", "1", "0", "1", "1"] },
    { "name": "TDATA", "type": "data", "color": "blue", "values": ["-", "D0", "D1", "D2", "D2", "-"] },
