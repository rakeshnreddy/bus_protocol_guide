      "type": "arbiter"
    },
    {
      "id": "apb_p1",
      "label": "UART (APB Slave)",
      "type": "slave"
    },
    {
      "id": "apb_p2",
      "label": "Timer (APB Slave)",
      "type": "slave"
    }
  ],
  "edges": [
