  "annotations": [
    { "nodeId": "arb", "message": "The arbiter observes HBUSREQx, drives HGRANTx and HMASTER, and changes ownership only at a legal transfer boundary." },
    { "nodeId": "mux", "message": "Only the granted master's address, control, and write-data path reaches the shared bus. Other masters must not drive the active transfer." },
    { "nodeId": "dec", "message": "The decoder maps the active HADDR to one HSEL. The return mux forwards only the selected slave's HRDATA, HREADY, and HRESP." },
    { "edgeId": "e-m1-arb", "message": "Request travels to the arbiter and grant returns to Master 1. Combining them on one routed connection prevents two arrows from occupying the same geometry." },
    { "edgeId": "e-dec-s2", "message": "The highlighted transaction selects internal SRAM. The boot ROM, peripheral bridge, and default slave remain inactive." },
    { "nodeId": "default", "message": "The default slave returns ERROR for valid NONSEQ/SEQ transfers to unmapped addresses. IDLE or BUSY at an unmapped address receives a zero-wait OKAY response." }
  ]
